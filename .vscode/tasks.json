{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Dash app in Docker for debugging",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker-compose.yml",
                "-f",
                "docker-compose.dev.yml",
                "-f",
                "docker-compose.debug.yml",
                "up",
                "--build",
                "--detach",
                "dash-app"
            ],
            "problemMatcher": []
        }
    ]
}
